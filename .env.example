# The web app proxies same-origin audit requests to the localhost-only runner.
ACCESSIBILITY_RUNNER_URL=http://127.0.0.1:4317
ACCESSIBILITY_RUNNER_TOKEN=replace-with-a-long-random-secret

# Runner capacity and retention. Defaults are intentionally conservative.
ACCESSIBILITY_MAX_CONCURRENT=1
ACCESSIBILITY_MAX_QUEUED=3
ACCESSIBILITY_MAX_RUNTIME_MS=480000
ACCESSIBILITY_ARTIFACT_TTL_MS=3600000

# Umami analytics. Only injected when NODE_ENV=production, so it's absent from
# local/dev builds even if these are set.
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=replace-with-your-umami-website-id
